DATABASE_URL="postgresql://taskmanager_app:taskmanager_app@localhost:5432/taskmanager_dev?schema=public"
PORT=5001
PUBLIC_REGISTRATION_ENABLED=true
JWT_SECRET=taskmanager_dev_jwt_secret_change_in_prod
# Preferred: comma-separated exact frontend origins (scheme + host + optional port, without paths).
# Wildcard * is rejected. CORS_ORIGIN is accepted as a single-value alias for staging tools.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN=
TRUST_PROXY=loopback
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000
AUTH_RATE_LIMIT_MAX_REQUESTS=30
MAX_UPLOAD_SIZE_MB=50
UPLOADS_DIR=
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf,text/plain,text/csv,application/json,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/zip,application/x-zip-compressed,application/vnd.rar,application/x-rar-compressed,application/x-7z-compressed

# Database backups. Scheduler is opt-in; manual scripts work regardless.
# File backups reuse the same BACKUP_DIR root and store archives in BACKUP_DIR/files.
# For staging/production prefer an absolute server path outside the frontend static directory.
BACKUP_ENABLED=false
BACKUP_FILES_ENABLED=false
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=2
BACKUP_HOUR=3
BACKUP_MINUTE=0

# Email intake through Yandex-compatible IMAP. Scheduler is opt-in;
# email:sync and email:smoke are one-shot scripts.
# Safe readiness check: npm run email:yandex:check
EMAIL_INTAKE_ENABLED=false
EMAIL_IMAP_HOST=imap.yandex.ru
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURE=true
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_INTAKE_MAILBOX=INBOX
EMAIL_INTAKE_MAX_MESSAGES=30
EMAIL_INTAKE_POLL_INTERVAL_MS=300000
EMAIL_ATTACHMENT_MAX_BYTES=26214400
EMAIL_DEFAULT_FOLDER_ID=
EMAIL_DEFAULT_ENTITY_ID=
EMAIL_DEFAULT_TYPE_ID=
EMAIL_DEFAULT_SUBTYPE_ID=

# Freshdesk API v2 import. API key is backend-only and never exposed by API.
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=
FRESHDESK_DEFAULT_FOLDER_ID=
FRESHDESK_DOWNLOAD_ATTACHMENTS_ENABLED=false
FRESHDESK_ATTACHMENT_MAX_BYTES=26214400
FRESHDESK_API_TIMEOUT_MS=30000
FRESHDESK_API_MAX_RETRIES=3
FRESHDESK_IMPORT_LOCK_TTL_MS=21600000

# Email replies through Yandex-compatible SMTP. Disabled by default;
# dry-run mode never sends real emails.
# Safe readiness check does not send email. Optional flags:
# npm run email:yandex:check -- --connect-imap --verify-smtp
EMAIL_OUTBOUND_ENABLED=false
EMAIL_SMTP_HOST=smtp.yandex.ru
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Office ServiceDesk
EMAIL_OUTBOUND_RETRY_DELAY_MINUTES=15
EMAIL_OUTBOUND_RETRY_BATCH_LIMIT=50
EMAIL_OUTBOX_WORKER_ENABLED=false
EMAIL_OUTBOX_WORKER_INTERVAL_MS=60000
EMAIL_OUTBOX_WORKER_BATCH_SIZE=20
EMAIL_OUTBOX_LOCK_TTL_MS=300000
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_NOTIFICATIONS_ENABLED=false
PORTAL_BASE_URL=http://localhost:5173
