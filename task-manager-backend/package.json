{
    "name": "task-manager-backend",
    "version": "1.0.0",
    "description": "",
    "main": "src/server.js",
    "scripts": {
        "start": "npm run prisma:generate && node src/server.js",
        "start:e2e": "set -a && . ./.env.test && export PORT=5002 CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173 BACKUP_ENABLED=false EMAIL_INTAKE_ENABLED=false && set +a && npm --prefix .. run build:contracts && npm run prisma:migrate:deploy && npm run prisma:seed && node src/server.js",
        "dev": "npm run prisma:generate && nodemon src/server.js",
        "dev:runtime": "npm run prisma:generate && npm --prefix .. run build:contracts && nodemon src/server.js",
        "test": "npm run prisma:generate && NODE_ENV=test node --env-file-if-exists=.env.test --test",
        "test:db:check-env": "node scripts/check-test-env.js",
        "test:db": "npm run test:db:check-env && set -a && . ./.env.test && set +a && prisma migrate deploy && npm run prisma:generate && NODE_ENV=test node --env-file=.env.test --test --test-concurrency=1",
        "prisma:generate": "prisma generate",
        "prisma:validate": "prisma validate",
        "prisma:migrate": "prisma migrate dev && prisma generate",
        "prisma:migrate:status": "prisma migrate status",
        "prisma:migrate:deploy": "prisma migrate deploy && prisma generate",
        "prisma:studio": "prisma studio",
        "prisma:seed": "npm run prisma:generate && node prisma/seed.js",
        "prisma:bootstrap-admin": "npm run prisma:generate && node prisma/bootstrap-admin.js",
        "prisma:backfill:departments": "npm run prisma:generate && node prisma/backfill-user-departments.js",
        "prisma:audit:manager-departments": "npm run prisma:generate && node prisma/audit-manager-departments.js",
        "prisma:backfill:manager-departments": "npm run prisma:generate && node prisma/backfill-manager-departments.js",
        "smoke:servicedesk": "node scripts/servicedesk-smoke.js",
        "smoke:canned-replies": "node scripts/canned-replies-smoke.js",
        "smoke:merge-approval": "node scripts/merge-approval-smoke.js",
        "smoke:sla": "node scripts/sla-smoke.js",
        "knowledge:smoke": "node scripts/knowledge-smoke.js",
        "backup:create": "node scripts/db-backup.js create",
        "backup:list": "node scripts/db-backup.js list",
        "backup:cleanup": "node scripts/db-backup.js cleanup",
        "backup:next-run": "node scripts/db-backup.js next-run",
        "backup:restore": "node scripts/db-backup.js restore",
        "backup:files:create": "node scripts/files-backup.js create",
        "backup:files:list": "node scripts/files-backup.js list",
        "backup:files:cleanup": "node scripts/files-backup.js cleanup",
        "backup:files:restore": "node scripts/files-backup.js restore",
        "email:sync": "node scripts/email-intake-sync.js",
        "email:smoke": "node scripts/email-intake-smoke.js",
        "email:reply-smoke": "node scripts/email-reply-smoke.js",
        "email:outbox:retry": "node scripts/email-outbox-retry.js",
        "email:yandex:check": "node scripts/email-yandex-check.js",
        "import:freshdesk": "node scripts/import-freshdesk.js",
        "import:freshdesk:api": "node scripts/import-freshdesk-api.js"
    },
    "keywords": [],
    "author": "",
