        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "express-validator": "^7.3.1",
        "helmet": "^8.1.0",
        "imapflow": "^1.4.7",
        "jsonwebtoken": "^9.0.3",
        "mailparser": "^3.9.14",
        "morgan": "^1.11.0",
        "multer": "^2.2.0",
        "nodemailer": "^9.0.3",
        "prisma": "^5.22.0"
    },
    "devDependencies": {
        "@types/dotenv": "^6.1.1",
