// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENT
  REQUESTER
  VIEWER
}

enum TaskStatus {
  NEW
  IN_PROGRESS
  REVIEW
  DONE
  POSTPONED
  REWORK
  MERGED
}

enum TaskMergeMode {
  LINK
  UNION
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskSourceChannel {
  WEB
  EMAIL
}

enum SlaTimerStatus {
  PENDING
  MET
  BREACHED
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
}

enum ChatKind {
  DIRECT
  GROUP
  DEPARTMENT
}

enum CannedReplyVisibility {
  PRIVATE
  SHARED
}

enum TaskTimelineEventType {
  TASK_CREATED
  TASK_UPDATED
  STATUS_CHANGED
  ASSIGNEE_ADDED
  ASSIGNEE_REMOVED
  COMMENT_ADDED
  INTERNAL_NOTE_ADDED
  FILE_ATTACHED
  FILE_DELETED
  TASK_MERGED
  CLOSE_APPROVED
  CANNED_REPLY_USED
  EMAIL_REPLY_SENT
  SLA_POLICY_APPLIED
  AUTOMATION_APPLIED
}

enum AutomationRuleTriggerType {
  TASK_CREATED
  EMAIL_TICKET_CREATED
}

enum AutomationRuleChannel {
  WEB
  EMAIL
}

enum AutomationRunStatus {
  SUCCESS
  ERROR
}

enum EmailOutboundStatus {
  DRY_RUN
  SENT
  FAILED
  RETRY_PENDING
}

enum ExternalSystem {
  FRESHDESK
  ONE_C
}

enum ExternalReferenceEntityType {
  TASK
  COMMENT
  ATTACHMENT
}

enum ImportRunStatus {
  DRY_RUN
  SUCCESS
  PARTIAL
  FAILED
}

enum TaskReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id                           String                 @id @default(cuid())
  name                         String
  avatar                       String?
  email                        String                 @unique
  password                     String
  role                         UserRole               @default(REQUESTER)
  isActive                     Boolean                @default(true)
  tokenVersion                 Int                    @default(0)
  position                     String?
  department                   String?
  skills                       Json?
  departmentMemberships        UserDepartment[]
  headedDepartments            Department[]           @relation("DepartmentHead")
  tasks                        Task[]                 @relation("TaskAuthor")
  assignees                    TaskAssignee[]         @relation("TaskAssignees")
  comments                     TaskComment[]
  attachments                  TaskAttachment[]
  reviews                      TaskReview[]
  account                      Account?
  notifications                Notification[]
  history                      TaskHistory[]
  supportTeamMemberships       SupportTeamMember[]
  taskMergesMergedBy           TaskMerge[]            @relation("TaskMergeMergedBy")
  taskCloseApprovals           TaskCloseApproval[]
  emailInboundMessages         EmailInboundMessage[]  @relation("EmailInboundCreatedUser")
  emailOutboundMessagesCreated EmailOutboundMessage[] @relation("EmailOutboundCreatedBy")
  importRunsCreated            FreshdeskImportRun[]   @relation("FreshdeskImportRunCreatedBy")
  cannedReplies                CannedReply[]
  taskTimelineEvents           TaskTimelineEvent[]    @relation("TaskTimelineActor")
  knowledgeArticlesCreated     KnowledgeArticle[]     @relation("KnowledgeArticleCreatedBy")
  knowledgeArticlesUpdated     KnowledgeArticle[]     @relation("KnowledgeArticleUpdatedBy")
  chatThreadsCreated           ChatThread[]           @relation("ChatThreadCreatedBy")
  chatMemberships              ChatMember[]
  chatMessages                 ChatMessage[]
  taskChatParticipations       TaskChatParticipant[]
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt

  @@map("users")
}

model Department {
  id          String           @id @default(cuid())
  name        String           @unique
  code        String?          @unique
  headUser    User?            @relation("DepartmentHead", fields: [headUserId], references: [id], onDelete: SetNull)
  headUserId  String?
  isActive    Boolean          @default(true)
  memberships UserDepartment[]
  tasks       Task[]
  chatThread  ChatThread?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("departments")
}

model UserDepartment {
  id           String     @id @default(cuid())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String
  isPrimary    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
  @@map("user_departments")
}

model Task {
  id                         String                  @id @default(cuid())
  ticketNumber               Int                     @unique @default(autoincrement()) @map("ticket_number")
  title                      String
  description                String?
  status                     TaskStatus              @default(NEW)
  priority                   TaskPriority            @default(MEDIUM)
  sourceChannel              TaskSourceChannel       @default(WEB)
  startDate                  DateTime?
  dueDate                    DateTime?
  progress                   Int                     @default(0)
  department                 Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId               String?
  team                       SupportTeam?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId                     String?
  folder                     TicketFolder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId                   String?
  entity                     TicketEntity?           @relation(fields: [entityId], references: [id], onDelete: SetNull)
  entityId                   String?
  type                       TicketType?             @relation(fields: [typeId], references: [id], onDelete: SetNull)
  typeId                     String?
  subtype                    TicketSubtype?          @relation(fields: [subtypeId], references: [id], onDelete: SetNull)
  subtypeId                  String?
  slaPolicy                  SlaPolicy?              @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  slaPolicyId                String?
  firstResponseDueAt         DateTime?
  resolutionDueAt            DateTime?
  firstResponseAt            DateTime?
  resolvedAt                 DateTime?
  slaFirstResponseStatus     SlaTimerStatus?
  slaResolutionStatus        SlaTimerStatus?
  author                     User                    @relation("TaskAuthor", fields: [authorId], references: [id])
  authorId                   String
  assignees                  TaskAssignee[]
  comments                   TaskComment[]
  attachments                TaskAttachment[]
  reviews                    TaskReview[]
  notifications              Notification[]
  history                    TaskHistory[]
  transactions               Transaction[]
  mergeMasterLinks           TaskMerge[]             @relation("TaskMergeMaster")
  mergeChildLinks            TaskMerge[]             @relation("TaskMergeChild")
  closeApprovals             TaskCloseApproval[]
  requesterCloseRequired     Boolean                 @default(false)
  requesterCloseApprovedAt   DateTime?
  requesterCloseApprovedById String?
  emailInboundMessages       EmailInboundMessage[]
  emailOutboundMessages      EmailOutboundMessage[]
  externalReferences         TaskExternalReference[]
  timelineEvents             TaskTimelineEvent[]
  chatParticipants           TaskChatParticipant[]
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  @@index([departmentId])
  @@index([teamId])
  @@index([folderId])
  @@index([entityId])
  @@index([typeId])
  @@index([subtypeId])
  @@index([slaPolicyId])
  @@index([updatedAt])
  @@index([status, updatedAt])
  @@index([authorId, updatedAt])
  @@map("tasks")
}

model TicketFolder {
  id              String              @id @default(cuid())
  name            String              @unique
  description     String?
  isActive        Boolean             @default(true)
  tasks           Task[]
  types           TicketType[]
  subtypes        TicketSubtype[]
  teams           SupportTeam[]
  teamAccesses    SupportTeamFolder[]
  slaPolicies     SlaPolicy[]
  productSettings ProductSettings[]   @relation("ProductSettingsDefaultFolder")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@map("ticket_folders")
}

model ProductSettings {
  id                     String        @id @default("default")
  portalName             String        @default("Office ServiceDesk")
  companyName            String        @default("")
  welcomeMessage         String?
  locale                 String        @default("ru-RU")
  timezone               String        @default("Europe/Moscow")
  defaultPriority        TaskPriority  @default(MEDIUM)
  dashboardEnabled       Boolean       @default(true)
  ticketsEnabled         Boolean       @default(true)
  ticketCreationEnabled  Boolean       @default(true)
  queueEnabled           Boolean       @default(true)
  knowledgeEnabled       Boolean       @default(true)
  cannedRepliesEnabled   Boolean       @default(true)
  chatsEnabled           Boolean       @default(true)
  teamEnabled            Boolean       @default(true)
  reportsEnabled         Boolean       @default(true)
  notificationsEnabled   Boolean       @default(true)
  automationEnabled      Boolean       @default(true)
  emailEnabled           Boolean       @default(true)
  taskAttachmentsEnabled Boolean       @default(true)
  freshdeskImportEnabled Boolean       @default(true)
  defaultFolder          TicketFolder? @relation("ProductSettingsDefaultFolder", fields: [defaultFolderId], references: [id], onDelete: Restrict)
  defaultFolderId        String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([defaultFolderId])
  @@map("product_settings")
}

model EmailSettings {
  id                         String   @id @default("default")
  intakeEnabled              Boolean  @default(false)
  imapHost                   String   @default("imap.yandex.ru")
  imapPort                   Int      @default(993)
  imapSecure                 Boolean  @default(true)
  imapUser                   String?
  imapPasswordEncrypted      String?
  mailbox                    String   @default("INBOX")
  intakeStartUid             Int      @default(1)
  intakeMaxMessages          Int      @default(30)
  intakePollIntervalMs       Int      @default(15000)
  attachmentMaxBytes         Int      @default(26214400)
  defaultFolderId            String?
  defaultEntityId            String?
  defaultTypeId              String?
  defaultSubtypeId           String?
  outboundEnabled            Boolean  @default(false)
  smtpHost                   String   @default("smtp.yandex.ru")
  smtpPort                   Int      @default(465)
  smtpSecure                 Boolean  @default(true)
  smtpUser                   String?
  smtpPasswordEncrypted      String?
  fromAddress                String?
  fromName                   String   @default("Office ServiceDesk")
  workerEnabled              Boolean  @default(true)
  workerIntervalMs           Int      @default(60000)
  workerBatchSize            Int      @default(20)
  lockTtlMs                  Int      @default(300000)
  maxAttempts                Int      @default(5)
  retryDelayMinutes          Int      @default(15)
  notificationsEnabled       Boolean  @default(true)
  notifyRequesterCreated     Boolean  @default(true)
  notifyRequesterComment     Boolean  @default(true)
  notifyRequesterStatus      Boolean  @default(true)
  notifyRequesterAssigned    Boolean  @default(false)
  notifyAssigneeAssigned     Boolean  @default(true)
  notifyChatMemberAdded      Boolean  @default(true)
  notifyTeamNewTask          Boolean  @default(true)
  portalBaseUrl              String?
  createdSubjectTemplate     String   @default("[Заявка #{{ticketNumber}}] Заявка принята: {{title}}")
  createdBodyTemplate        String   @default("Здравствуйте, {{requesterName}}!\n\nМы зарегистрировали вашу заявку #{{ticketNumber}} «{{title}}».\nТекущий статус: {{status}}.\n\n{{portalLink}}")
  commentSubjectTemplate     String   @default("[Заявка #{{ticketNumber}}] Новый ответ: {{title}}")
  commentBodyTemplate        String   @default("Здравствуйте, {{requesterName}}!\n\nПо заявке #{{ticketNumber}} появился новый ответ.\n\n{{comment}}\n\n{{portalLink}}")
  statusSubjectTemplate      String   @default("[Заявка #{{ticketNumber}}] Статус изменён: {{status}}")
  statusBodyTemplate         String   @default("Здравствуйте, {{requesterName}}!\n\nСтатус заявки #{{ticketNumber}} «{{title}}» изменён: {{oldStatus}} → {{status}}.\n\n{{portalLink}}")
  assignedSubjectTemplate    String   @default("[Заявка #{{ticketNumber}}] Назначен исполнитель")
  assignedBodyTemplate       String   @default("Здравствуйте, {{requesterName}}!\n\nПо заявке #{{ticketNumber}} назначен исполнитель: {{assigneeName}}.\n\n{{portalLink}}")
  assigneeSubjectTemplate    String   @default("[Заявка #{{ticketNumber}}] Вы назначены исполнителем: {{title}}")
  assigneeBodyTemplate       String   @default("Здравствуйте, {{assigneeName}}!\n\nВы назначены исполнителем заявки #{{ticketNumber}} «{{title}}».\nЗаявитель: {{requesterName}}\nПриоритет: {{priority}}\n\nОписание:\n{{description}}\n\n{{portalLink}}")
  chatMemberSubjectTemplate  String   @default("[Чат] Вас добавили: {{chatTitle}}")
  chatMemberBodyTemplate     String   @default("Здравствуйте, {{memberName}}!\n\nВас добавили в чат «{{chatTitle}}».\nДобавил: {{addedByName}}.\n\n{{portalLink}}")
  teamNewTaskSubjectTemplate String   @default("[Команда {{teamName}}] Новая заявка #{{ticketNumber}}: {{title}}")
  teamNewTaskBodyTemplate    String   @default("Здравствуйте, {{memberName}}!\n\nВ очереди команды «{{teamName}}» появилась новая заявка #{{ticketNumber}} «{{title}}».\nПапка: {{folderName}}\nТип: {{typeName}}\nПодтип: {{subtypeName}}\nЗаявитель: {{requesterName}}\nПриоритет: {{priority}}\n\nОписание:\n{{description}}\n\n{{portalLink}}")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("email_settings")
}

model TicketEntity {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String?      @unique
  description String?
  isActive    Boolean      @default(true)
  tasks       Task[]
  types       TicketType[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("ticket_entities")
}

model TicketType {
  id          String          @id @default(cuid())
  name        String          @unique
  code        String?         @unique
  description String?
  isActive    Boolean         @default(true)
  folder      TicketFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId    String?
  entity      TicketEntity?   @relation(fields: [entityId], references: [id], onDelete: SetNull)
  entityId    String?
  team        SupportTeam?    @relation("TicketTypeRoutingTeam", fields: [teamId], references: [id], onDelete: SetNull)
  teamId      String?
  tasks       Task[]
  subtypes    TicketSubtype[]
  slaPolicies SlaPolicy[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([folderId])
  @@index([entityId])
  @@index([teamId])
  @@map("ticket_types")
}

model TicketSubtype {
  id          String        @id @default(cuid())
  name        String
  code        String?       @unique
  description String?
  isActive    Boolean       @default(true)
  type        TicketType    @relation(fields: [typeId], references: [id], onDelete: Restrict)
  typeId      String
  folder      TicketFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId    String?
  team        SupportTeam?  @relation("TicketSubtypeRoutingTeam", fields: [teamId], references: [id], onDelete: SetNull)
  teamId      String?
  tasks       Task[]
  slaPolicies SlaPolicy[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([typeId, name])
  @@index([folderId])
  @@index([teamId])
  @@map("ticket_subtypes")
}

model SlaPolicy {
  id                   String         @id @default(cuid())
  name                 String         @unique
  description          String?
  isActive             Boolean        @default(true)
  sortOrder            Int            @default(0)
  folder               TicketFolder?  @relation(fields: [folderId], references: [id], onDelete: Restrict)
  folderId             String?
  type                 TicketType?    @relation(fields: [typeId], references: [id], onDelete: Restrict)
  typeId               String?
  subtype              TicketSubtype? @relation(fields: [subtypeId], references: [id], onDelete: Restrict)
  subtypeId            String?
  priority             TaskPriority?
  firstResponseMinutes Int?
  resolutionMinutes    Int?
  tasks                Task[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([isActive, sortOrder])
  @@index([folderId])
  @@index([typeId])
  @@index([subtypeId])
  @@index([priority])
  @@map("sla_policies")
}

model SupportTeam {
  id             String              @id @default(cuid())
  name           String              @unique
  description    String?
  isActive       Boolean             @default(true)
  folder         TicketFolder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId       String?
  folderAccesses SupportTeamFolder[]
  members        SupportTeamMember[]
  tasks          Task[]
  routedTypes    TicketType[]        @relation("TicketTypeRoutingTeam")
  routedSubtypes TicketSubtype[]     @relation("TicketSubtypeRoutingTeam")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([folderId])
  @@map("support_teams")
}

model SupportTeamFolder {
  id        String       @id @default(cuid())
  team      SupportTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  folder    TicketFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([teamId, folderId])
  @@index([folderId])
  @@map("support_team_folders")
}

model SupportTeamMember {
  id        String      @id @default(cuid())
  team      SupportTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      String?
  isLead    Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([teamId, userId])
  @@index([userId])
  @@map("support_team_members")
}

model KnowledgeArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  body        String
  category    String?
  isPublished Boolean  @default(true)
  createdBy   User?    @relation("KnowledgeArticleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  updatedBy   User?    @relation("KnowledgeArticleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([isPublished, updatedAt])
  @@map("knowledge_articles")
}

model TaskAssignee {
  id     String @id @default(cuid())
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
  user   User   @relation("TaskAssignees", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([taskId, userId])
  @@index([userId, taskId])
  @@map("task_assignees")
}

model TaskMerge {
  id           String        @id @default(cuid())
  masterTask   Task          @relation("TaskMergeMaster", fields: [masterTaskId], references: [id], onDelete: Cascade)
  masterTaskId String
  childTask    Task          @relation("TaskMergeChild", fields: [childTaskId], references: [id], onDelete: Cascade)
  childTaskId  String
  mergeMode    TaskMergeMode
  mergedByUser User          @relation("TaskMergeMergedBy", fields: [mergedBy], references: [id])
  mergedBy     String
  mergedAt     DateTime      @default(now())
  reason       String?

  @@unique([masterTaskId, childTaskId])
  @@index([childTaskId])
  @@index([mergedBy])
  @@index([mergeMode])
  @@map("task_merges")
}

model TaskCloseApproval {
  id         String   @id @default(cuid())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  approvedAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_close_approvals")
}

model TaskComment {
  id                    String                  @id @default(cuid())
  content               String
  visibility            CommentVisibility       @default(PUBLIC)
  task                  Task                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId                String
  author                User                    @relation(fields: [authorId], references: [id])
  authorId              String
  emailOutboundMessages EmailOutboundMessage[]
  externalReferences    TaskExternalReference[]
  createdAt             DateTime                @default(now())

  @@index([taskId, visibility, createdAt])
  @@map("task_comments")
}

model ChatThread {
  id                    String                 @id @default(cuid())
  kind                  ChatKind
  title                 String?
  avatar                String?
  directKey             String?                @unique
  department            Department?            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId          String?                @unique
  createdBy             User?                  @relation("ChatThreadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById           String?
  members               ChatMember[]
  messages              ChatMessage[]
  emailOutboundMessages EmailOutboundMessage[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([kind, updatedAt])
  @@map("chat_threads")
}

model ChatMember {
  id         String     @id @default(cuid())
  chat       ChatThread @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  lastReadAt DateTime?
  joinedAt   DateTime   @default(now())

  @@unique([chatId, userId])
  @@index([userId, chatId])
  @@map("chat_members")
}

model ChatMessage {
  id          String           @id @default(cuid())
  chat        ChatThread       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId      String
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  content     String
  attachments ChatAttachment[]
  editedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([chatId, createdAt])
  @@index([authorId])
  @@map("chat_messages")
}

model ChatAttachment {
  id        String      @id @default(cuid())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  filename  String
  path      String
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime    @default(now())

  @@index([messageId])
  @@map("chat_attachments")
}

model ChatSettings {
  id                     String   @id @default("default")
  chatsEnabled           Boolean  @default(true)
  directChatsEnabled     Boolean  @default(true)
  departmentChatsEnabled Boolean  @default(true)
  ticketChatsEnabled     Boolean  @default(true)
  attachmentsEnabled     Boolean  @default(true)
  maxAttachmentSizeMb    Int      @default(25)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("chat_settings")
}

model TaskChatParticipant {
  id        String   @id @default(cuid())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  addedById String?
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId, taskId])
  @@map("task_chat_participants")
}

model EmailOutboundMessage {
  id                String              @id @default(cuid())
  dedupeKey         String?             @unique
  task              Task?               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId            String?
  chat              ChatThread?         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId            String?
  comment           TaskComment?        @relation(fields: [commentId], references: [id], onDelete: SetNull)
  commentId         String?
  recipientEmail    String
  recipientName     String?
  fromEmail         String
  subject           String
  bodyText          String?
  textPreview       String?
  status            EmailOutboundStatus
  dryRun            Boolean             @default(false)
  messageId         String?
  providerMessageId String?
  inReplyTo         String?
  references        String?
  errorMessage      String?
  attempts          Int                 @default(0)
  lastAttemptAt     DateTime?
  nextRetryAt       DateTime?
  lockedAt          DateTime?
  lockedBy          String?
  notifications     Notification[]
  createdBy         User?               @relation("EmailOutboundCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([taskId, createdAt])
  @@index([chatId, createdAt])
  @@index([status, nextRetryAt])
  @@index([lockedAt])
  @@index([createdById])
  @@index([commentId])
  @@map("email_outbound_messages")
}

model CannedReply {
  id         String                @id @default(cuid())
  title      String
  body       String
  category   String?
  isActive   Boolean               @default(true)
  visibility CannedReplyVisibility @default(PRIVATE)
  author     User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([authorId, visibility])
  @@index([category])
  @@index([isActive])
  @@map("canned_replies")
}

model TaskTimelineEvent {
  id          String                @id @default(cuid())
  task        Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
  actor       User?                 @relation("TaskTimelineActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId     String?
  type        TaskTimelineEventType
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime              @default(now())

  @@index([taskId, createdAt])
  @@index([taskId, type])
  @@index([actorId])
  @@index([type, createdAt])
  @@map("task_timeline_events")
}

model TaskAttachment {
  id                 String                  @id @default(cuid())
  filename           String
  path               String
  task               Task                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId             String
  uploadedBy         User                    @relation(fields: [uploadedById], references: [id])
  uploadedById       String
  externalReferences TaskExternalReference[]
  createdAt          DateTime                @default(now())

  @@map("task_attachments")
}

model EmailInboundMessage {
  id            String    @id @default(cuid())
  messageId     String    @unique
  mailbox       String?
  uid           Int?
  fromEmail     String
  fromName      String?
  subject       String?
  receivedAt    DateTime?
  textPreview   String?
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId        String?
  createdUser   User?     @relation("EmailInboundCreatedUser", fields: [createdUserId], references: [id], onDelete: SetNull)
  createdUserId String?
  processedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@unique([mailbox, uid])
  @@index([fromEmail])
  @@index([taskId])
  @@index([createdUserId])
  @@map("email_inbound_messages")
}

model AutomationRule {
  id                              String                    @id @default(cuid())
  name                            String
  description                     String?
  isActive                        Boolean                   @default(true)
  sortOrder                       Int                       @default(0)
  triggerType                     AutomationRuleTriggerType
  conditionChannel                AutomationRuleChannel?
  conditionFolderId               String?
  conditionEntityId               String?
  conditionTypeId                 String?
  conditionSubtypeId              String?
  conditionPriority               TaskPriority?
  conditionRequesterEmailContains String?
  conditionTitleContains          String?
  actionSetFolderId               String?
  actionSetEntityId               String?
  actionSetTypeId                 String?
  actionSetSubtypeId              String?
  actionSetPriority               TaskPriority?
  actionSetAssigneeIdsEnabled     Boolean                   @default(false)
  actionSetAssigneeIds            String[]                  @default([])
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @updatedAt

  @@index([triggerType, isActive, sortOrder])
  @@index([conditionFolderId])
  @@index([conditionEntityId])
  @@index([conditionTypeId])
  @@index([conditionSubtypeId])
  @@map("automation_rules")
}

model AutomationRun {
  id             String                    @id @default(cuid())
  ruleId         String
  ruleName       String
  taskId         String
  triggerType    AutomationRuleTriggerType
  appliedActions Json?
  status         AutomationRunStatus
  errorMessage   String?
  createdAt      DateTime                  @default(now())

  @@index([taskId])
  @@index([ruleId])
  @@index([createdAt])
  @@map("automation_runs")
}

model TaskReview {
  id         String           @id @default(cuid())
  status     TaskReviewStatus @default(PENDING)
  amount     Float?
  comment    String?
  task       Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String
  reviewer   User?            @relation(fields: [reviewerId], references: [id])
  reviewerId String?
  createdAt  DateTime         @default(now())

  @@map("task_reviews")
}

model TaskHistory {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  field     String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())

  @@map("task_history")
}

model Account {
  id           String        @id @default(cuid())
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String?       @unique
  type         String
  balance      Float         @default(0)
  transactions Transaction[]

  @@map("accounts")
}

model Transaction {
  id          String          @id @default(cuid())
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId   String
  amount      Float
  type        TransactionType @default(INCOME)
  category    String?
  taskId      String?
  task        Task?           @relation(fields: [taskId], references: [id])
  description String?
  createdAt   DateTime        @default(now())

  @@map("transactions")
}

model Notification {
  id            String                @id @default(cuid())
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  type          String
  title         String
  message       String
  eventKey      String?
  metadata      Json?
  isRead        Boolean               @default(false)
  readAt        DateTime?
  taskId        String?
  task          Task?                 @relation(fields: [taskId], references: [id], onDelete: SetNull)
  emailOutboxId String?
  emailOutbox   EmailOutboundMessage? @relation(fields: [emailOutboxId], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([userId, eventKey])
  @@index([userId, isRead, createdAt])
  @@index([taskId])
  @@index([emailOutboxId])
  @@map("notifications")
}

model TaskExternalReference {
  id             String                      @id @default(cuid())
  system         ExternalSystem
  entityType     ExternalReferenceEntityType
  externalId     String
  externalNumber String?
  metadata       Json?
  task           Task?                       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId         String?
  comment        TaskComment?                @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId      String?
  attachment     TaskAttachment?             @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  attachmentId   String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([system, entityType, externalId])
  @@index([taskId])
  @@index([commentId])
  @@index([attachmentId])
  @@map("task_external_references")
}

model FreshdeskImportRun {
  id          String          @id @default(cuid())
  source      ExternalSystem  @default(FRESHDESK)
  status      ImportRunStatus
  dryRun      Boolean         @default(false)
  fileName    String?
  summary     Json?
  errors      Json?
  createdBy   User?           @relation("FreshdeskImportRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  finishedAt  DateTime?

  @@index([source, createdAt])
  @@index([createdById])
  @@map("freshdesk_import_runs")
}

model FreshdeskImportLock {
  id         String   @id
  ownerId    String
  acquiredAt DateTime @default(now())
  expiresAt  DateTime

  @@map("freshdesk_import_locks")
}
