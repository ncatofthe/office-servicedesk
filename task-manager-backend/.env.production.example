# Office ServiceDesk backend production environment

# Required: PostgreSQL connection used by Prisma and runtime services.
DATABASE_URL="postgresql://taskmanager_app:change_me@127.0.0.1:5432/taskmanager_prod?schema=public"

# Required: backend listen port.
PORT=5001
HOST=127.0.0.1
PUBLIC_REGISTRATION_ENABLED=false

# Required: long random secret for JWT signing.
JWT_SECRET=change_me_to_a_long_random_secret

# Required: exact frontend origins (scheme + host + optional port). Wildcard * is rejected.
# Preferred variable is CORS_ORIGINS; use commas when there is more than one frontend.
# CORS_ORIGIN is accepted as a single-value alias for simple staging setups.
CORS_ORIGINS=https://servicedesk.company.local
CORS_ORIGIN=
TRUST_PROXY=loopback

# Recommended production defaults.
NODE_ENV=production
RATE_LIMIT_WINDOW_MS=900000
# Sized for 15-20 employees sharing one office NAT, including background refreshes.
RATE_LIMIT_MAX_REQUESTS=10000
AUTH_RATE_LIMIT_MAX_REQUESTS=100
PRODUCT_SETTINGS_CACHE_TTL_MS=30000
CHAT_SETTINGS_CACHE_TTL_MS=30000
CHAT_DEPARTMENT_SYNC_TTL_MS=60000

# Upload policy.
MAX_UPLOAD_SIZE_MB=50
# Optional absolute path for uploaded files. Empty value means task-manager-backend/uploads.
UPLOADS_DIR=/opt/officesd/task-manager-backend/uploads
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf,text/plain,text/csv,application/json,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/zip,application/x-zip-compressed,application/vnd.rar,application/x-rar-compressed,application/x-7z-compressed

# Database backups. Files backups use the same BACKUP_DIR root and are stored in BACKUP_DIR/files.
# Prefer an absolute server path outside frontend static directories.
BACKUP_ENABLED=true
BACKUP_FILES_ENABLED=true
BACKUP_DIR=/opt/officesd/backups
BACKUP_RETENTION_DAYS=2
BACKUP_HOUR=3
BACKUP_MINUTE=0

# Email intake scheduler. Keep disabled until mailbox credentials are ready.
# Validate safely with:
# npm --workspace task-manager-backend run email:yandex:check -- --connect-imap --verify-smtp
EMAIL_INTAKE_ENABLED=false
EMAIL_IMAP_HOST=imap.yandex.ru
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURE=true
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_INTAKE_MAILBOX=INBOX
EMAIL_INTAKE_MAX_MESSAGES=30
EMAIL_INTAKE_POLL_INTERVAL_MS=300000
EMAIL_ATTACHMENT_MAX_BYTES=26214400
EMAIL_DEFAULT_FOLDER_ID=
EMAIL_DEFAULT_ENTITY_ID=
EMAIL_DEFAULT_TYPE_ID=
EMAIL_DEFAULT_SUBTYPE_ID=

# Freshdesk migration. Keep key only in backend environment.
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=
FRESHDESK_DEFAULT_FOLDER_ID=
FRESHDESK_DOWNLOAD_ATTACHMENTS_ENABLED=false
FRESHDESK_ATTACHMENT_MAX_BYTES=26214400
FRESHDESK_API_TIMEOUT_MS=30000
FRESHDESK_API_MAX_RETRIES=3
FRESHDESK_IMPORT_LOCK_TTL_MS=21600000

# Email replies. Keep disabled until SMTP credentials and DNS are verified.
EMAIL_OUTBOUND_ENABLED=false
EMAIL_SMTP_HOST=smtp.yandex.ru
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Office ServiceDesk
EMAIL_OUTBOUND_RETRY_DELAY_MINUTES=15
EMAIL_OUTBOUND_RETRY_BATCH_LIMIT=50
EMAIL_OUTBOX_WORKER_ENABLED=false
EMAIL_OUTBOX_WORKER_INTERVAL_MS=60000
EMAIL_OUTBOX_WORKER_BATCH_SIZE=20
EMAIL_OUTBOX_LOCK_TTL_MS=300000
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_NOTIFICATIONS_ENABLED=false
PORTAL_BASE_URL=https://servicedesk.company.local
