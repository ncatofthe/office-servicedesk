# Copy this file to .env.test before running backend DB-backed tests.
# Use a dedicated test database, not your regular dev database.
# After editing .env.test, run:
# npm --workspace task-manager-backend run test:db
DATABASE_URL="postgresql://taskmanager_app:taskmanager_app@localhost:5432/taskmanager_test?schema=public"
JWT_SECRET=taskmanager_test_jwt_secret
UPLOADS_DIR=./uploads-test
