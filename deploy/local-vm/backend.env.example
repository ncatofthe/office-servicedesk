# Office ServiceDesk local VM env template
# Copy to: /opt/officesd/task-manager-backend/.env

DATABASE_URL="postgresql://servicedesk:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/officesd?schema=public"
PORT=5001
PUBLIC_REGISTRATION_ENABLED=false
NODE_ENV=production
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_40_PLUS_CHARS

# Put your VM address here. Examples:
# CORS_ORIGINS=http://192.168.1.50,http://servicedesk.local
CORS_ORIGINS=http://SERVER_IP,http://servicedesk.local
CORS_ORIGIN=
PORTAL_BASE_URL=http://SERVER_IP
TRUST_PROXY=loopback

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000
AUTH_RATE_LIMIT_MAX_REQUESTS=30

MAX_UPLOAD_SIZE_MB=50
UPLOADS_DIR=/opt/officesd/task-manager-backend/uploads
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf,text/plain,text/csv,application/json,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/zip,application/x-zip-compressed,application/vnd.rar,application/x-rar-compressed,application/x-7z-compressed

BACKUP_ENABLED=true
BACKUP_FILES_ENABLED=true
BACKUP_DIR=/opt/officesd/backups
BACKUP_RETENTION_DAYS=2
BACKUP_HOUR=3
BACKUP_MINUTE=0

# First local launch: keep email features disabled. Enable step by step after Yandex checks.
EMAIL_INTAKE_ENABLED=false
EMAIL_IMAP_HOST=imap.yandex.ru
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURE=true
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_INTAKE_MAILBOX=INBOX
EMAIL_INTAKE_MAX_MESSAGES=30
EMAIL_INTAKE_POLL_INTERVAL_MS=300000
EMAIL_ATTACHMENT_MAX_BYTES=26214400
EMAIL_DEFAULT_FOLDER_ID=
EMAIL_DEFAULT_ENTITY_ID=
EMAIL_DEFAULT_TYPE_ID=
EMAIL_DEFAULT_SUBTYPE_ID=

EMAIL_OUTBOUND_ENABLED=false
EMAIL_SMTP_HOST=smtp.yandex.ru
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Office ServiceDesk
EMAIL_OUTBOUND_RETRY_DELAY_MINUTES=15
EMAIL_OUTBOUND_RETRY_BATCH_LIMIT=50
EMAIL_OUTBOX_WORKER_ENABLED=false
EMAIL_OUTBOX_WORKER_INTERVAL_MS=60000
EMAIL_OUTBOX_WORKER_BATCH_SIZE=20
EMAIL_OUTBOX_LOCK_TTL_MS=300000
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_NOTIFICATIONS_ENABLED=false
