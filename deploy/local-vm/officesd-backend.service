[Unit]
Description=Office ServiceDesk Backend
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/officesd
EnvironmentFile=/opt/officesd/task-manager-backend/.env
Environment=HOST=127.0.0.1
Environment=RATE_LIMIT_MAX_REQUESTS=10000
Environment=PRODUCT_SETTINGS_CACHE_TTL_MS=30000
Environment=CHAT_SETTINGS_CACHE_TTL_MS=30000
Environment=CHAT_DEPARTMENT_SYNC_TTL_MS=60000
ExecStart=/usr/bin/node task-manager-backend/src/server.js
Restart=always
RestartSec=5
TimeoutStopSec=30
User=servicedesk
Group=servicedesk

[Install]
WantedBy=multi-user.target
